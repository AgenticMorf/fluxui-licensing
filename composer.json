{
    "name": "agenticmorf/fluxui-licensing",
    "description": "FluxUI Pro (Livewire) frontend for masterix21/laravel-licensing",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/AgenticMorf/fluxui-licensing",
    "support": {
        "source": "https://github.com/AgenticMorf/fluxui-licensing",
        "issues": "https://github.com/AgenticMorf/fluxui-licensing/issues"
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "laravel/framework": "^11.0|^12.0",
        "livewire/flux": "^2.0",
        "livewire/livewire": "^3.0|^4.0",
        "masterix21/laravel-licensing": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "AgenticMorf\\FluxUILicensing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AgenticMorf\\FluxUILicensing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AgenticMorf\\FluxUILicensing\\FluxUILicensingServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
